{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keiretsu:schema:admission:receipt:1",
  "type": "object",
  "properties": {
    "entitlementId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "operation": {
      "type": "string",
      "enum": [
        "redeem",
        "replace-credential",
        "revoke"
      ]
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "authorizedBy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "human"
              ]
            },
            "personId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
            },
            "actingFor": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "_tag": {
                      "type": "string",
                      "enum": [
                        "entity"
                      ]
                    },
                    "entityId": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "_tag",
                    "entityId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "_tag": {
                      "type": "string",
                      "enum": [
                        "counterparty"
                      ]
                    },
                    "counterpartyId": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "_tag",
                    "counterpartyId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "_tag",
            "personId",
            "actingFor"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "agent"
              ]
            },
            "agentId": {
              "type": "string",
              "minLength": 1
            },
            "operatorPersonId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "not": {}
                }
              ]
            },
            "sessionId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
                },
                {
                  "not": {}
                }
              ]
            }
          },
          "required": [
            "_tag",
            "agentId",
            "operatorPersonId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "system"
              ]
            },
            "systemId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "_tag",
            "systemId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "committedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "redemptionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
        },
        {
          "not": {}
        }
      ]
    },
    "scanId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
        },
        {
          "not": {}
        }
      ]
    }
  },
  "required": [
    "entitlementId",
    "revision",
    "operation",
    "requestDigest",
    "idempotencyKey",
    "authorizedBy",
    "committedAt"
  ],
  "additionalProperties": false,
  "$defs": {},
  "x-keiretsu-semantic-rules": [
    "admission.scan-result-binding",
    "admission.receipt-is-not-payment"
  ]
}
