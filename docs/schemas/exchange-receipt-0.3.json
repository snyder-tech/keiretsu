{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keiretsu:schema:exchange:receipt:0.3",
  "type": "object",
  "properties": {
    "specVersion": {
      "type": "string",
      "enum": [
        "0.3"
      ]
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
    },
    "receiver": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "entity"
              ]
            },
            "entityId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
            }
          },
          "required": [
            "_tag",
            "entityId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "_tag": {
              "type": "string",
              "enum": [
                "counterparty"
              ]
            },
            "counterpartyId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}(?![\\s\\S])"
            }
          },
          "required": [
            "_tag",
            "counterpartyId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "phase": {
      "type": "string",
      "enum": [
        "classification",
        "validation",
        "application"
      ]
    },
    "receivedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z(?![\\s\\S])"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "rejected",
        "held"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "recordDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "classified",
              "invalid",
              "unauthorized",
              "staged",
              "held",
              "applied",
              "conflict",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "index",
          "kind",
          "schema",
          "recordDigest",
          "outcome",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "originalReceiptDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        {
          "not": {}
        }
      ]
    },
    "applicationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "not": {}
        }
      ]
    },
    "receiverPeriod": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])(?![\\s\\S])"
        },
        {
          "not": {}
        }
      ]
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]{86}(?![\\s\\S])"
        },
        {
          "not": {}
        }
      ]
    }
  },
  "required": [
    "specVersion",
    "bundleId",
    "issuer",
    "receiver",
    "seq",
    "contentDigest",
    "phase",
    "receivedAt",
    "outcome",
    "records",
    "receiptDigest"
  ],
  "additionalProperties": false,
  "$defs": {},
  "x-keiretsu-semantic-rules": [
    "exchange.complete-record-identity",
    "exchange.phase-and-aggregate",
    "exchange.receipt-digest",
    "exchange.receipt-signature-and-audience"
  ]
}
